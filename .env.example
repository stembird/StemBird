# ---------------------------------------------------------------------------
# CareerSasa environment variables (server-side)
# ---------------------------------------------------------------------------
#
# Copy this file to .env.local for local development and add the same values
# to your Vercel project for production.

# --- Supabase --------------------------------------------------------------
# Project URL + anon/publishable key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Service-role key (server only — NEVER expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI post copy generation (optional; falls back to built-in templates) --
# Used by the Social Publishing copy generator. DeepSeek is the primary
# provider; Gemini is the fallback. At least one set of keys is required for
# AI-generated posts. Without keys, rule-based templates are used instead.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- Buffer (Social Publishing) --------------------------------------------
# Optional — if unset, admins can connect Buffer from the admin UI
# (Social Publishing → Buffer Settings → connect), which stores the key in the
# service-role buffer_config table. The env var is the recommended production
# approach because the key never touches the database.
# Generate your free Buffer API key at https://publish.buffer.com/settings/api
BUFFER_API_KEY=

# --- Site -------------------------------------------------------------------
# Used for links in social posts and email automation.
NEXT_PUBLIC_SITE_URL=https://www.careersasa.co.ke
