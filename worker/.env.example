# ============================================================
# CareerSasa background worker — environment configuration
# Copy to .env and fill in real values.
# ============================================================

# ── Supabase (same DB the Vercel app uses) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Scraper user that owns published jobs (required)
SCRAPER_USER_ID=

# ── AI enrichment (DeepSeek primary; Gemini backup) ──────────
# Matches the app's provider chain (src/lib/aiProviders.ts).
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_2=
DEEPSEEK_MODEL=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# ── Scheduling (node-cron expressions, UTC) ───────────────────
# Defaults: discover daily at 05:00, process every 15 minutes
WORKER_CRON_DISCOVER=0 5 * * *
WORKER_CRON_PROCESS=*/15 * * * *
WORKER_CRON_SOCIAL=0 3,7 * * *
# How many queue items to process per run (default 10)
WORKER_PROCESS_BATCH=10
# Soft time budget per process run in ms (default 240000)
WORKER_PROCESS_BUDGET_MS=240000
# Soft time budget per discover run in ms (default 600000 = 10 min)
WORKER_DISCOVER_BUDGET_MS=600000

# Buffer (Social auto-queue). Optional if the key is already in buffer_config
# from Admin → Social Publishing. Generate at publish.buffer.com/settings/api
BUFFER_API_KEY=

# ── Optional HTTP trigger (for admin dashboard proxy) ─────────
# Set to a port to enable: POST /discover and POST /process
# WORKER_HTTP_PORT=8787
# Shared secret must be sent as header: x-worker-secret
WORKER_SECRET=
